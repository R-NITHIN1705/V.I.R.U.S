# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Tests connect directly to database (not pgbouncer).
# Doctrine appends _test suffix via dbname_suffix config: app → app_test
DATABASE_URL="postgresql://app:!ChangeMe!@database:5432/app?serverVersion=17&charset=utf8"
GDELT_ENABLED=true
GDELT_TIMEOUT=10
GDELT_BASE_URL=https://api.gdeltproject.org

 ### API SPORTS ##
SPORTS_API_ENABLED=true
SPORTS_API_KEY=

##movie  TMDB ###
TMDB_ENABLED=true
TMDB_READ_ACCESS_TOKEN=


## CRICKET DATA ##
CRICKET_API_ENABLED=true
CRICKET_API_KEY=


###> symfony/panther ###
PANTHER_APP_ENV=test
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
PANTHER_DEVTOOLS=0
PANTHER_CHROME_ARGUMENTS='--no-sandbox --disable-gpu --ignore-certificate-errors --disable-dev-shm-usage'
