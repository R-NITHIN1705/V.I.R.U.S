{% extends 'base.html.twig' %}
{% block sidebar %}{% endblock %}
{% block title %}Forgot password · News Aggregator{% endblock %}
{% block body %}<div class="flex justify-center px-3 py-8"><section class="card w-full max-w-md bg-base-100 shadow-2xl border border-base-300"><div class="card-body gap-4">
    <div><h1 class="text-2xl font-bold">Reset your password</h1><p class="text-base-content/70 mt-1">Enter the email for your account. If it matches, we’ll send a secure reset link.</p></div>
    {% if error %}<div class="alert alert-error" role="alert">{{ error }}</div>{% endif %}
    <form method="post" class="space-y-4"><input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}"><label class="form-control"><span class="label-text mb-1">Email</span><input class="input input-bordered" type="email" name="email" value="{{ email }}" autocomplete="email" required></label><button class="btn btn-primary w-full" type="submit">Send reset link</button></form>
    <p class="text-center text-sm"><a class="link link-primary" href="{{ path('app_login') }}">Back to sign in</a></p>
</div></section></div>{% endblock %}
