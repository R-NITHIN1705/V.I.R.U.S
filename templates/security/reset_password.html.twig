{% extends 'base.html.twig' %}
{% block sidebar %}{% endblock %}
{% block title %}Choose a new password · News Aggregator{% endblock %}
{% block body %}<div class="flex justify-center px-3 py-8"><section class="card w-full max-w-md bg-base-100 shadow-2xl border border-base-300"><div class="card-body gap-4">
    <div><h1 class="text-2xl font-bold">Choose a new password</h1><p class="text-base-content/70 mt-1">Set a strong password with at least 12 characters.</p></div>
    {% if errors %}<div class="alert alert-error" role="alert"><ul>{% for message in errors %}<li>{{ message }}</li>{% endfor %}</ul></div>{% endif %}
    {% if token %}<form method="post" class="space-y-4" data-auth-form><input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}"><input type="hidden" name="token" value="{{ token }}"><label class="form-control"><span class="label-text mb-1">New password</span><div class="join"><input class="input input-bordered join-item w-full" type="password" name="password" minlength="12" autocomplete="new-password" required><button type="button" class="btn btn-outline join-item" data-password-toggle>Show</button></div></label><label class="form-control"><span class="label-text mb-1">Confirm password</span><input class="input input-bordered" type="password" name="confirm_password" minlength="12" autocomplete="new-password" required></label><button class="btn btn-primary w-full" type="submit"><span data-submit-label>Update password</span><span class="loading loading-spinner loading-sm hidden" data-submit-spinner></span></button></form>{% else %}<div class="alert alert-warning">This link is invalid or expired. Request a new one.</div><a class="btn btn-primary" href="{{ path('app_forgot_password') }}">Request reset link</a>{% endif %}
</div></section></div>{% endblock %}
