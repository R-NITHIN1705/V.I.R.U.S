{% extends 'base.html.twig' %}
{% block title %}Sources — V.I.R.U.S.{% endblock %}
{% block body %}
<section class="page-shell source-page">
  <header class="page-heading">
    <div><span class="eyebrow">COVERAGE NETWORK</span><h1>Sources</h1><p>Trusted feeds powering your live news brief.</p></div>
    <div class="source-actions"><a href="{{ path('app_sources_export_opml') }}" class="quiet-link">Export</a><a href="{{ path('app_sources_import_opml') }}" class="quiet-link">Import</a><span id="fetch-all-btn"><button hx-post="{{ path('app_sources_fetch_all') }}" hx-headers='{"X-CSRF-Token":"{{ csrf_token('fetch_all_sources') }}"}' hx-target="#fetch-all-btn" hx-swap="innerHTML" hx-indicator="#fetch-all-spinner" class="lux-button secondary"><span id="fetch-all-spinner" class="htmx-indicator loading loading-spinner loading-xs"></span> Update all</button></span><a href="{{ path('app_sources_new') }}" class="lux-button">+ Add source</a></div>
  </header>
  <div class="source-toolbar"><label class="source-search"><span>⌕</span><input id="source-search" type="search" placeholder="Search sources, topics or feeds"></label><select id="region-filter" class="source-filter"><option value="">All regions</option><option value="national">National</option><option value="international">International</option><option value="state">State / Regional</option></select><select id="category-filter" class="source-filter"><option value="">All categories</option>{% for category in sourceCategories %}<option value="{{ category|lower }}">{{ category }}</option>{% endfor %}</select><select id="health-filter" class="source-filter"><option value="">All health</option><option value="healthy">Healthy</option><option value="degraded">Warning</option><option value="failing">Failed</option><option value="disabled">Disabled</option></select><select id="sort-sources" class="source-filter"><option value="name">Sort: Name</option><option value="health">Sort: Health</option><option value="articles">Sort: Story count</option></select><span class="source-total">{{ sources|length }} sources · updates every 3.5 minutes</span></div>
  {% if sources is empty %}{% include 'components/_empty_state.html.twig' with {message:'No sources configured yet.', action_label:'Add a source', action_url:path('app_sources_new')} %}{% else %}
  {% set groups = {'national':'National','international':'International','state':'State / Regional','other':'Other sources'} %}
  {% for key,label in groups %}{% set groupSources = sources|filter(s => (s.region ?: 'other') == key) %}{% if groupSources is not empty %}
  <section class="source-group" data-source-group="{{ key }}"><div class="source-group-heading"><h2>{{ label }}</h2><span>{{ groupSources|length }} feeds</span></div><div class="source-grid">
  {% for source in groupSources %}{% set health = source.enabled ? source.healthStatus.value : 'disabled' %}<article class="source-card" data-source-card data-name="{{ (source.name ~ ' ' ~ source.feedUrl ~ ' ' ~ source.category.name)|lower }}" data-region="{{ source.region ?: 'other' }}" data-category="{{ source.category.name|lower }}" data-health="{{ health }}" data-articles="{{ articleCounts[source.id] ?? 0 }}">
    <div class="source-card-top"><div class="source-avatar">{{ source.name|slice(0,1)|upper }}</div><div class="source-title"><h3>{{ source.name }}</h3><a href="{{ source.siteUrl ?: source.feedUrl }}" target="_blank" rel="noopener">{{ source.feedUrl|replace({'https://':''})|slice(0,48) }}{% if source.feedUrl|length > 55 %}…{% endif %}</a></div><span class="state-pill state-{{ health }}"><i></i>{{ health == 'degraded' ? 'Warning' : health|capitalize }}</span></div>
    <div class="source-meta"><span class="category-chip">{{ source.category.name }}</span>{% if source.defaultSource %}<span class="category-chip default-chip">Default</span>{% endif %}<span class="article-count">{{ articleCounts[source.id] ?? 0 }} stories</span></div>
    <div class="source-metrics"><div><small>SUCCESS RATE</small><b>{% if source.successRate is not null %}{{ source.successRate }}%{% else %}—{% endif %}</b></div><div><small>LAST UPDATED</small><b>{% if source.lastFetchedAt %}<time datetime="{{ source.lastFetchedAt|date('c') }}" class="timeago">{{ source.lastFetchedAt|date('M j, H:i') }}</time>{% else %}Not yet{% endif %}</b></div><div><small>NEXT UPDATE</small><b>{{ source.enabled ? 'Within 3.5 min' : 'Paused' }}</b></div></div>
    {% if source.lastErrorMessage and health in ['degraded','failing'] %}<p class="source-error">This feed couldn’t update. We’ll try again on the next cycle.</p>{% endif %}
    <footer class="source-card-footer"><form method="post" action="{{ path('app_sources_edit', {id:source.id}) }}" class="enable-inline"><input type="hidden" name="_token" value="{{ csrf_token('edit_source') }}"><input type="hidden" name="name" value="{{ source.name }}"><input type="hidden" name="feed_url" value="{{ source.feedUrl }}"><input type="hidden" name="site_url" value="{{ source.siteUrl }}"><input type="hidden" name="category_id" value="{{ source.category.id }}"><input type="hidden" name="language" value="{{ source.language }}"><input type="hidden" name="fetch_interval_minutes" value="{{ source.fetchIntervalMinutes }}"><input type="hidden" name="reliability_weight" value="{{ source.reliabilityWeight }}"><input type="hidden" name="full_text_enabled" value="{{ source.fullTextEnabled ? '1' : '' }}"><input type="hidden" name="region" value="{{ source.region }}"><label><input type="checkbox" name="enabled" value="1" {{ source.enabled ? 'checked' : '' }} onchange="this.form.submit()"><span>{{ source.enabled ? 'Enabled' : 'Paused' }}</span></label></form><div class="source-controls"><a href="{{ path('app_sources_edit',{id:source.id}) }}" class="quiet-link">Edit</a><span id="fetch-btn-{{ source.id }}"><button hx-post="{{ path('app_sources_fetch',{id:source.id}) }}" hx-headers='{"X-CSRF-Token":"{{ csrf_token('trigger_fetch_source') }}"}' hx-target="#fetch-btn-{{ source.id }}" hx-swap="innerHTML" hx-indicator="#fetch-spin-{{ source.id }}" class="quiet-link"><span id="fetch-spin-{{ source.id }}" class="htmx-indicator loading loading-spinner loading-xs"></span> Update now</button></span><button hx-post="{{ path('app_sources_delete',{id:source.id}) }}" hx-headers='{"X-CSRF-Token":"{{ csrf_token('delete_source') }}"}' hx-confirm="Delete this source?" hx-target="closest article" hx-swap="outerHTML swap:300ms" class="quiet-link danger-link">Remove</button></div></footer>
  </article>{% endfor %}</div></section>{% endif %}{% endfor %}{% endif %}
</section>
<script>
(()=>{const search=document.querySelector('#source-search'),region=document.querySelector('#region-filter'),category=document.querySelector('#category-filter'),health=document.querySelector('#health-filter'),sort=document.querySelector('#sort-sources');function filter(){document.querySelectorAll('[data-source-card]').forEach(card=>{card.hidden=Boolean((search.value&&!card.dataset.name.includes(search.value.toLowerCase()))||(region.value&&card.dataset.region!==region.value)||(category.value&&card.dataset.category!==category.value)||(health.value&&card.dataset.health!==health.value))});document.querySelectorAll('[data-source-group]').forEach(g=>g.hidden=!g.querySelector('[data-source-card]:not([hidden])'));}function reorder(){document.querySelectorAll('[data-source-group] .source-grid').forEach(grid=>[...grid.children].sort((a,b)=>sort.value==='articles'?Number(b.dataset.articles)-Number(a.dataset.articles):sort.value==='health'?a.dataset.health.localeCompare(b.dataset.health):a.dataset.name.localeCompare(b.dataset.name)).forEach(el=>grid.append(el)));} [search,region,category,health].forEach(el=>el.addEventListener('input',filter));sort.addEventListener('change',reorder);})();
</script>
{% endblock %}
