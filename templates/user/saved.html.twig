{% extends 'base.html.twig' %}
{% block title %}Saved Stories · V.I.R.U.S.{% endblock %}
{% block body %}
<section class="page-shell saved-page"><header class="page-heading"><div><span class="eyebrow">YOUR READING LIST</span><h1>Saved stories</h1><p>Stories you’ve bookmarked for later.</p></div><span class="category-chip">{{ bookmarks|length }} saved</span></header>
{% if bookmarks is empty %}<div class="saved-empty"><span aria-hidden="true">▣</span><h2>No saved stories yet</h2><p>Bookmark a story from your feed and it will be waiting here.</p><a class="lux-button" href="{{ path('app_dashboard') }}">Browse the news</a></div>{% else %}<div class="saved-grid">{% for bookmark in bookmarks %}{% set article = bookmark.article %}<article class="saved-card">
<a href="{{ path('app_story',{id:article.id}) }}" class="saved-image article-image-frame" aria-label="Open {{ article.title }}">{% include 'components/_provenance_image.html.twig' with {article: article} %}</a>
<div class="saved-card-copy">{% include 'components/_article_topic_tags.html.twig' with {article: article} %}<h2><a href="{{ path('app_story',{id:article.id}) }}">{{ article.title }}</a></h2>{% if article.summary %}<p>{{ article.summary }}</p>{% endif %}<div class="saved-byline"><span>{{ article.source.name }}</span><span>·</span><time>{{ article.publishedAt ? article.publishedAt|date('M j, Y') : article.fetchedAt|date('M j, Y') }}</time><span class="saved-date">Saved {{ bookmark.createdAt|date('M j') }}</span></div><div class="saved-actions"><a class="quiet-link" href="{{ path('app_story',{id:article.id}) }}">Read story →</a>{% include 'components/_bookmark_button.html.twig' with {article:article,isBookmarked:true,savedView:true} %}</div></div></article>{% endfor %}</div>{% endif %}</section>
{% endblock %}
