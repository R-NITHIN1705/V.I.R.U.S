{% extends 'base.html.twig' %}
{% block title %}Explore the world's news{% if query %} — {{ query }}{% endif %}{% endblock %}
{% block body %}
<section class="page-shell search-page">
    <header class="page-heading">
        <div><span class="eyebrow">DISCOVERY</span><h1>Search the world's news</h1><p>Search connected publishers and recent global coverage. Narrow your results by date, country, language, topic, or source.</p></div>
    </header>

    <form action="{{ path('app_search') }}" method="get" class="search-form">
        <label class="search-query-label" for="search-query">Topic, person, event, place, or keyword</label>
        <div class="search-query-row">
            <input id="search-query" type="search" name="q" value="{{ query }}" maxlength="256" placeholder="e.g. Hyderabad floods, OpenAI, India reforms" class="input input-bordered" autocomplete="off">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
        <div class="search-filters">
            <label>When
                <select name="period" class="select select-bordered">
                    <option value="recent" {{ filters.period == 'recent' ? 'selected' }}>Recent</option>
                    <option value="today" {{ filters.period == 'today' ? 'selected' }}>Today</option>
                    <option value="yesterday" {{ filters.period == 'yesterday' ? 'selected' }}>Yesterday</option>
                    <option value="week" {{ filters.period == 'week' ? 'selected' }}>This week</option>
                    <option value="month" {{ filters.period == 'month' ? 'selected' }}>This month</option>
                    <option value="year" {{ filters.period == 'year' ? 'selected' }}>Specific year</option>
                    <option value="custom" {{ filters.period == 'custom' ? 'selected' }}>Custom range</option>
                </select>
            </label>
            <label>Year
                <input type="number" name="year" min="1979" max="{{ 'now'|date('Y') }}" value="{{ filters.year }}" class="input input-bordered" placeholder="2020">
            </label>
            <label>From
                <input type="date" name="date_from" value="{{ filters.date_from }}" class="input input-bordered">
            </label>
            <label>To
                <input type="date" name="date_to" value="{{ filters.date_to }}" class="input input-bordered">
            </label>
            <label>Country code
                <input type="text" name="country" value="{{ filters.country }}" maxlength="2" pattern="[A-Za-z]{2}" list="search-countries" class="input input-bordered" placeholder="Worldwide">
                <datalist id="search-countries">{% for source in sources %}{% if source.country %}<option value="{{ source.country }}">{% endif %}{% endfor %}</datalist>
                <small>ISO alpha-2, for example IN or US</small>
            </label>
            <label>Language
                <select name="language" class="select select-bordered">
                    <option value="">Any language</option>
                    <option value="en" {{ filters.language == 'en' ? 'selected' }}>English</option>
                    {% set languages = [] %}{% for source in sources %}{% if source.language and source.language not in languages %}{% set languages = languages|merge([source.language]) %}{% endif %}{% endfor %}
                    {% for language in languages %}<option value="{{ language }}" {{ filters.language == language ? 'selected' }}>{{ language|upper }}</option>{% endfor %}
                </select>
            </label>
            <label>Topic
                <select name="category" class="select select-bordered">
                    <option value="">All topics</option>
                    {% for category in categories %}<option value="{{ category.slug }}" {{ filters.category == category.slug ? 'selected' }}>{{ category.name }}</option>{% endfor %}
                </select>
            </label>
            <label>Source
                <select name="source" class="select select-bordered">
                    <option value="">All sources</option>
                    {% for source in sources %}<option value="{{ source.id }}" {{ filters.source == source.id ? 'selected' }}>{{ source.name }}</option>{% endfor %}
                </select>
            </label>
        </div>
        <div class="search-actions"><a href="{{ path('app_search') }}">Clear filters</a></div>
    </form>

    <div id="search-results">
        {% include 'search/_results.html.twig' %}
    </div>
</section>
{% endblock %}
