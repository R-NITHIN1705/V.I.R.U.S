# News Aggregator — Environment Variables
# Copy to .env.local and adjust values

# Symfony
APP_ENV=dev
APP_SECRET=change-me-to-a-random-string

# Database (PostgreSQL)
POSTGRES_VERSION=17
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=!ChangeMe!

# Admin user (default: demo@localhost / demo)
ADMIN_EMAIL=demo@localhost
ADMIN_PASSWORD_HASH='$2y$12$M9bYgEuL2NVffm.iz4JalOd8ePY3JDtMQEvvaK7zL8tFVy6PgRa3a'
AUTH_FROM_EMAIL=no-reply@example.com

# OpenRouter AI (optional — rule-based fallback works without it)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_BLOCKED_MODELS=

# Groq AI (OpenAI-compatible; supports chat, tool calls, and text generation)
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Notifications (install desired transport package)
# Pushover: pushover://USER_KEY:APP_TOKEN@default
# Slack: slack://TOKEN@default?channel=CHANNEL
# Telegram: telegram://TOKEN@default?channel=CHAT_ID
NOTIFIER_CHATTER_DSN=null://null

# Data retention (days)
RETENTION_ARTICLES=90
RETENTION_LOGS=30

# Feed fetching (default interval; per-category overrides in DB)
FETCH_DEFAULT_INTERVAL_MINUTES=15

# On-demand global article discovery through GDELT DOC (recent article window)
GDELT_ENABLED=true
GDELT_TIMEOUT=10
GDELT_BASE_URL=https://api.gdeltproject.org

# Optional live football data from API-Sports. A key is required to enable it.
SPORTS_API_ENABLED=false
SPORTS_API_KEY=
CRICKET_API_ENABLED=false
CRICKET_API_KEY=
TMDB_ENABLED=false
TMDB_READ_ACCESS_TOKEN=

# Display languages for multi-language translation (comma-separated: en,de,fr)
# Articles from non-matching sources are translated to each display language
DISPLAY_LANGUAGES=en

# Docker ports
HTTP_PORT=8180
HTTPS_PORT=8443
